# Margaliot 2.0 — environment variables.
# Copy to `.env` (git-ignored) and fill in. NEVER commit real values.
# Validation lives in src/lib/env.ts; the app refuses to start when a required value is missing.

# --- Required everywhere -----------------------------------------------------
# PostgreSQL connection string. Local Docker default (docker-compose.yml):
#   postgres://postgres:postgres@127.0.0.1:5432/margaliot
DATABASE_URL=
# Payload encryption/JWT secret, at least 32 characters: openssl rand -hex 32
PAYLOAD_SECRET=

# --- Environment -------------------------------------------------------------
# development | preview | production   (default: development)
# Anything other than "production" is noindex (ADR-0002). Never set "production" in Phase A.
SITE_ENV=development
# Absolute base URL of this deployment. Defaults to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Required in preview/production, optional in development -----------------
# Vercel Blob store token for media uploads (local disk is used when empty).
BLOB_READ_WRITE_TOKEN=
# Shared secret for the draft-preview route (T12), at least 32 characters.
PREVIEW_SECRET=

# --- Integration tests only (pnpm test:int) ----------------------------------
# A DISPOSABLE database; it is wiped on every run. Must differ from DATABASE_URL.
# DATABASE_URL_TEST=postgres://postgres:postgres@127.0.0.1:5432/margaliot_test

# --- Later tasks (not used yet) ----------------------------------------------
# Cloudflare Turnstile (T16)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Resend email (only after decision on contact-form destination)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
