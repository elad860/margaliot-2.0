{
  "name": "margaliot-2.0",
  "version": "0.1.0",
  "private": true,
  "description": "Margaliot 2.0 (מרגליות 2.0) — website and CMS skeleton (Phase A)",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0 && node scripts/check-logical-css.mjs && node scripts/check-tokens.mjs",
    "lint:css": "node scripts/check-logical-css.mjs",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.int.config.mts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:status": "payload migrate:status",
    "seed": "payload run src/cms/seed/run.ts",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/live-preview-react": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/plugin-form-builder": "3.92.1",
    "@payloadcms/plugin-seo": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/storage-vercel-blob": "3.92.1",
    "@payloadcms/translations": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "graphql": "16.14.2",
    "next": "16.4.4",
    "payload": "3.92.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
